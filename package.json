{
  "name": "hatchworks-replica",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static replica of hatchworks.com (local study/reference build).",
  "scripts": {
    "crawl": "node scripts/import/crawl.mjs",
    "extract": "node scripts/import/extract.mjs",
    "posts": "node scripts/import/posts-index.mjs",
    "import": "npm run crawl && npm run extract",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run build && npm run serve",
    "compare": "node scripts/compare.mjs",
    "build:aurora": "node scripts/build.mjs --variant=aurora",
    "serve:aurora": "node scripts/serve.mjs --variant=aurora",
    "dev:aurora": "npm run build:aurora && npm run serve:aurora",
    "build:terracotta": "node scripts/build.mjs --variant=terracotta",
    "serve:terracotta": "node scripts/serve.mjs --variant=terracotta",
    "dev:terracotta": "npm run build:terracotta && npm run serve:terracotta",
    "build:frost": "node scripts/build.mjs --variant=frost",
    "serve:frost": "node scripts/serve.mjs --variant=frost",
    "dev:frost": "npm run build:frost && npm run serve:frost",
    "build:emerald": "node scripts/build.mjs --variant=emerald",
    "serve:emerald": "node scripts/serve.mjs --variant=emerald",
    "dev:emerald": "npm run build:emerald && npm run serve:emerald",
    "build:original": "node scripts/build.mjs --variant=original",
    "serve:original": "node scripts/serve.mjs --variant=original",
    "check:variant": "node scripts/variant-check.mjs"
  },
  "devDependencies": {
    "cheerio": "1.0.0",
    "playwright-core": "^1.48.2"
  }
}
